# ─── Database (Supabase-hosted) ───────────────────────────────────────────────
DB_HOST=aws-1-<project-ref>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>
DB_NAME=postgres
DB_SSLMODE=require

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_USER=kafka
KAFKA_PASSWORD=kafkasecret

# ─── Redis ────────────────────────────────────────────────────────────────────
# Full connection URL. Use rediss:// for TLS (e.g. Upstash); redis:// for plain.
REDIS_URL=redis://localhost:6379/0

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

TARGET_ROLES=Backend Engineer,Platform Engineer,Infrastructure Engineer,Software Engineer,Full Stack Engineer,Software Developer
YEARS_EXP=4

# ─── LLM multi-slot routing ───────────────────────────────────────────────────
# Preferred: point at a YAML file. Canonical source lives in the helm chart.
# API keys in the YAML use ${VAR} syntax and are expanded from this file at load time.
# For local `go run` from the repo root, use: k8s/helm/jobradar/files/llm-slots.yaml
LLM_SLOTS_CONFIG=k8s/helm/jobradar/files/llm-slots.yaml

# Fallback: JSON env vars (used when LLM_SLOTS_CONFIG is unset or file missing)
# FILTER_LLM_SLOTS='[{"key_id":"k1","api_key":"AIza...","model":"gemini-2.5-flash-lite","rpm":15,"rpd":1500,"tpm_in":1000000}]'
# ENRICHER_LLM_SLOTS='[{"key_id":"k1","api_key":"AIza...","model":"gemini-2.5-pro","rpm":5,"rpd":500,"tpm_in":250000}]'

# ─── LLM cooldown backoff ─────────────────────────────────────────────────────
LLM_COOLDOWN_BASE_SECONDS=60
LLM_COOLDOWN_MAX_SECONDS=3600
LLM_COOLDOWN_JITTER=0.2

# ─── Filter worker ────────────────────────────────────────────────────────────
FILTER_BATCH_SIZE=50
FILTER_FLUSH_TIMEOUT_SECONDS=10
FILTER_LLM_PARALLELISM=5

# ─── Enricher worker ──────────────────────────────────────────────────────────
ENRICHER_FETCH_CONCURRENCY=15
ENRICHER_LLM_BATCH_SIZE=5
ENRICHER_FLUSH_TIMEOUT_SECONDS=120
ENRICHER_DEFAULT_RPS=2
ENRICHER_DEFAULT_BURST=3
ENRICHER_JITTER_MS=200
DISCARD_JOB_WITH_EXP_GT=0

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=480
SCHEDULER_STUCK_TIMEOUT_MINUTES=30
SCHEDULER_CHECK_INTERVAL_SECONDS=60

# ─── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_POLL_INTERVAL_SECONDS=60
CRAWLER_STUCK_TIMEOUT_SECONDS=120
CRAWLER_HEARTBEAT_INTERVAL_SECONDS=30
SCAN_COMPANY_DELAY_SECONDS=60

# ─── Google scraper ───────────────────────────────────────────────────────────
GOOGLE_SCRAPER_MIN_DELAY=15000        # ms between page loads
GOOGLE_SCRAPER_MAX_DELAY=20000        # ms between page loads
GOOGLE_SCRAPER_TIMEOUT_MS=60000       # total scrape timeout per company
GOOGLE_SCRAPER_MAX_PAGES=2            # 0 = unlimited
GOOGLE_SCRAPER_ENRICH_MIN=60000
GOOGLE_SCRAPER_ENRICH_MAX=120000

# ─── Auth (Supabase) ──────────────────────────────────────────────────────────
# Use SUPABASE_JWKS_URL (ES256, preferred) OR SUPABASE_JWT_SECRET (HS256). NEVER both.
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
JWT_CLOCK_SKEW_SECONDS=60
JWKS_CACHE_TTL_SECONDS=600
# Supabase admin REST API — required for DELETE /api/me. Leave empty in dev.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── API server ───────────────────────────────────────────────────────────────
API_READ_HEADER_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=15
API_WRITE_TIMEOUT_SECONDS=30
API_IDLE_TIMEOUT_SECONDS=60
API_BODY_LIMIT_BYTES=1048576

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Observability ────────────────────────────────────────────────────────────
METRICS_ADDR=127.0.0.1:9100
JAEGER_ENDPOINT=http://localhost:4318
LOKI_URL=http://loki:3100/loki/api/v1/push
LOKI_RETENTION=720h
HOST_NAME=jobradar
AUDIT_SYNC_INTERVAL_SECONDS=900
AUDIT_SYNC_STATE_FILE=/var/lib/audit-sync/state.json

# ─── Rate limits (backend per-user token bucket) ─────────────────────────────
RATE_LIMIT_READ_RPM=30
RATE_LIMIT_WRITE_RPM=20
RATE_LIMIT_ADMIN_RPM=120
CACHE_TTL_USER_SECONDS=60
# Process-local LRU in front of Redis for all API cache reads. Caps how long
# the API keeps a value in-memory before re-reading Redis; set to 0 to
# disable the local layer entirely. Cross-replica invalidations rely on TTL
# expiry — keep this short for fast-moving identity bundles.
IDENTITY_CACHE_LOCAL_TTL_SECONDS=30
IDENTITY_CACHE_LOCAL_MAX_ENTRIES=10000

# ─── Dev auth bypass (leave empty in production) ──────────────────────────────
DEV_TOKEN=

# ─── Frontend (Vite dev server + Docker build args) ───────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ─── Supabase (Caddy proxy + audit sync) ─────────────────────────────────────
SUPABASE_PROJECT_HOST=<project-ref>.supabase.co
SUPABASE_DB_URL=

# ─── Domain / TLS (prod only — leave blank for local) ────────────────────────
DOMAIN=
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ─── Caddy rate limits ────────────────────────────────────────────────────────
RATE_LIMIT_API_PER_MIN=30
RATE_LIMIT_CALLBACK_PER_MIN=5

# ─── CrowdSec ─────────────────────────────────────────────────────────────────
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_KEY=

# ─── Grafana OAuth (prod only — leave blank for local) ───────────────────────
GF_AUTH_GOOGLE_CLIENT_ID=
GF_AUTH_GOOGLE_CLIENT_SECRET=
GF_AUTH_GOOGLE_ALLOWED_EMAILS=you@example.com

# ─── Host port bindings ───────────────────────────────────────────────────────
API_HOST_PORT=127.0.0.1:8080
CONSOLE_HOST_PORT=127.0.0.1:3000
GRAFANA_PORT=127.0.0.1:3001
PROMETHEUS_PORT=127.0.0.1:9090
JAEGER_UI_PORT=127.0.0.1:16686
JAEGER_OTLP_PORT=127.0.0.1:4318
LOKI_PORT=127.0.0.1:3100
