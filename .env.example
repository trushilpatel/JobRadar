# ─── Frontend build args (passed to console Docker build) ─────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
VITE_APP_DOMAIN=localhost
VITE_ALLOWED_EMAIL=you@example.com

# ─── Domain / TLS (prod only — leave blank for local) ────────────────────────
DOMAIN=
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ─── Supabase (Caddy proxy + audit sync) ─────────────────────────────────────
SUPABASE_PROJECT_HOST=<project-ref>.supabase.co
SUPABASE_DB_URL=

# ─── Caddy rate limits ────────────────────────────────────────────────────────
RATE_LIMIT_API_PER_MIN=30
RATE_LIMIT_CALLBACK_PER_MIN=5

# ─── CrowdSec ─────────────────────────────────────────────────────────────────
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_KEY=

# ─── Grafana OAuth (prod only — leave blank for local) ───────────────────────
GF_AUTH_GOOGLE_CLIENT_ID=
GF_AUTH_GOOGLE_CLIENT_SECRET=
GF_AUTH_GOOGLE_ALLOWED_EMAILS=you@example.com

# ─── Observability ────────────────────────────────────────────────────────────
LOKI_URL=http://loki:3100/loki/api/v1/push
LOKI_RETENTION=720h
HOST_NAME=jobradar
AUDIT_SYNC_INTERVAL_SECONDS=900
AUDIT_SYNC_STATE_FILE=/var/lib/audit-sync/state.json

# ─── Host port bindings (loopback defaults work for both local and prod) ──────
# Override to 0.0.0.0:PORT to expose publicly (not recommended — use Caddy)
API_HOST_PORT=127.0.0.1:8080
CONSOLE_HOST_PORT=127.0.0.1:3000
GRAFANA_PORT=127.0.0.1:3001
PROMETHEUS_PORT=127.0.0.1:9090
JAEGER_UI_PORT=127.0.0.1:16686
JAEGER_OTLP_PORT=127.0.0.1:4318
LOKI_PORT=127.0.0.1:3100
