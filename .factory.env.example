# AutoCodeEngine config example — commit this, copy to .factory.env and edit.
# Override any variable per-run: make run FEATURE=foo MAX_AGENT_CALLS=20

# ── Models ────────────────────────────────────────────────────────────────────
# Haiku:  fast, cheap  — prd_linter, ux, cicd, push_to_pr, steward
# Sonnet: main work    — engineer, qa, performance, red_team
# Opus:   best reasoning — architect only (called once per feature)
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6
MODEL_OPUS=claude-opus-4-8

# ── Loop limits ───────────────────────────────────────────────────────────────
# MAX_LOOP_BACKS: retries allowed per gate before the loop pauses for human input.
MAX_LOOP_BACKS=3

# MAX_AGENT_CALLS: hard ceiling on total agent calls per feature run.
# A clean run (no loop-backs) uses ~11–15 calls.
MAX_AGENT_CALLS=30

# ── Local dev ─────────────────────────────────────────────────────────────────
# BASE_URL: where your local dev server runs (used by k6 performance tests).
BASE_URL=http://localhost:3000

# TEST_CMD: your full test suite command.
# Leave empty for auto-detection (detects jest / pytest / go test / rspec).
# Example: TEST_CMD=make test
TEST_CMD=

# ── Gate control ──────────────────────────────────────────────────────────────
# SKIP_GATES: comma-separated list of gates to bypass.
#
# Available gates:
#   prd_linter   — validates PRD completeness before any code work (Haiku)
#   architect    — produces ADR: data models, API contracts, security model (Opus)
#   engineer     — TDD: writes failing tests first, then implements (Sonnet)
#   qa           — full test suite + mutation testing ≥70% threshold (Sonnet)
#   ux           — reviews UI/API ergonomics, accessibility, error messages (Haiku)
#   performance  — k6 load tests against BASE_URL; enforces p95/p99/error budgets (Sonnet)
#   cicd         — sets up or validates CI pipeline (Haiku)
#   red_team     — security review from PRD only, no implementation context (Sonnet)
#   push_to_pr   — creates branch, commits, pushes, opens GitHub PR (Haiku)
#
# Common presets:
#   SKIP_GATES=performance,red_team      # fast iteration, saves ~6-8 calls
#   SKIP_GATES=ux                        # backend-only features
#   SKIP_GATES=ux,performance            # API-only features
#   SKIP_GATES=                          # run everything (recommended for production)
SKIP_GATES=

# ── Performance budgets ───────────────────────────────────────────────────────
# Only enforced when the performance gate runs (not in SKIP_GATES).
#
# PERF_P95_MS    — 95th percentile response time ceiling (milliseconds)
# PERF_P99_MS    — 99th percentile response time ceiling (milliseconds)
# PERF_ERROR_RATE — max allowed HTTP error rate under load (ratio 0–1, e.g. 0.01 = 1%)
# PERF_BUNDLE_KB  — frontend JS bundle size limit (kilobytes)
PERF_P95_MS=300
PERF_P99_MS=1000
PERF_ERROR_RATE=0.01
PERF_BUNDLE_KB=20

# ── Per-agent turn limits (optional) ─────────────────────────────────────────
# Uncomment to cap how many turns a specific agent can take.
# Useful if one agent keeps hitting its ceiling.
# TURNS_PRD_LINTER=5
# TURNS_ARCHITECT=15
# TURNS_ENGINEER=20
# TURNS_QA=20
# TURNS_UX=10
# TURNS_PERFORMANCE=15
# TURNS_CICD=6
# TURNS_RED_TEAM=25
# TURNS_PUSH_TO_PR=8
# TURNS_STEWARD=15
