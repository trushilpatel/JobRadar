#!/usr/bin/env sh

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { printf "${GREEN}✓${NC} %s\n" "$1"; }
fail() { printf "${RED}✗${NC} %s\n" "$1"; }
info() { printf "${YELLOW}→${NC} %s\n" "$1"; }

FAILED=0

# ── Block direct commits to main ─────────────────────────────────────────────
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$CURRENT_BRANCH" = "main" ]; then
  fail "Direct commits to 'main' are not allowed."
  printf "${YELLOW}→${NC} Create a feature branch: ${YELLOW}git checkout -b <branch-name>${NC}\n"
  exit 1
fi

# ── Format staged files (gofmt + prettier) ───────────────────────────────────
info "Formatting staged files..."
if ./node_modules/.bin/lint-staged; then
  pass "Formatting"
else
  fail "Formatting failed"
  FAILED=1
fi

# ── Backend: Go lint + unit tests ────────────────────────────────────────────
if git diff --cached --name-only | grep -q '^backend/'; then
  info "Backend changed — running Go lint (changed files only)..."
  if command -v golangci-lint >/dev/null 2>&1; then
    if (cd backend && golangci-lint run --config ../.github/.golangci.yml --new-from-rev=HEAD --timeout 2m); then
      pass "Go lint"
    else
      fail "Go lint failed"
      FAILED=1
    fi
  else
    info "golangci-lint not found — skipping (install via: brew install golangci-lint)"
  fi

  info "Backend changed — running Go unit tests (race detector)..."
  if (cd backend && go test -race -short -count=1 ./...); then
    pass "Go unit tests"
  else
    fail "Go unit tests failed"
    FAILED=1
  fi
else
  info "No backend changes — skipping Go lint and tests"
fi

# ── Frontend: lint + type-check ───────────────────────────────────────────────
if git diff --cached --name-only | grep -q '^ui/'; then
  info "Frontend changed — running ESLint..."
  if (cd ui/console && npm run lint --silent); then
    pass "ESLint"
  else
    fail "ESLint failed"
    FAILED=1
  fi

  info "Frontend changed — running TypeScript check..."
  if (cd ui/console && npx tsc --noEmit); then
    pass "TypeScript"
  else
    fail "TypeScript check failed"
    FAILED=1
  fi
else
  info "No frontend changes — skipping lint and tsc"
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 1 ]; then
  printf "${RED}Pre-commit checks failed. Fix errors above and try again.${NC}\n"
  printf "Emergency bypass: ${YELLOW}git commit --no-verify${NC}\n"
  exit 1
fi

printf "${GREEN}All checks passed.${NC}\n"
