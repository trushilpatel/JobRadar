#!/usr/bin/env sh

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { printf "${GREEN}✓${NC} %s\n" "$1"; }
fail() { printf "${RED}✗${NC} %s\n" "$1"; }
info() { printf "${YELLOW}→${NC} %s\n" "$1"; }

FAILED=0

# ── Block direct commits to main or dev (serial, instant) ────────────────────
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "dev" ]; then
  fail "Direct commits to '${CURRENT_BRANCH}' are not allowed."
  printf "${YELLOW}→${NC} Create a feature branch: ${YELLOW}git checkout -b <branch-name>${NC}\n"
  exit 1
fi

# ── Format staged files — SERIAL, must precede the parallel phase ─────────────
# lint-staged rewrites staged files in place (gofmt -w, prettier --write). Every
# check below READS those files, so formatting cannot overlap them without a
# read-mid-rewrite race. Everything after this point is read-only.
info "Formatting staged files..."
if ./node_modules/.bin/lint-staged; then
  pass "Formatting"
else
  fail "Formatting failed"
  FAILED=1
fi

# ── Parallel phase ────────────────────────────────────────────────────────────
# The remaining checks are independent and read-only, so they run concurrently —
# wall-clock is ~the slowest check, not their sum. Each job buffers output to a
# temp log; only FAILED jobs print their log, so parallel output stays readable.
# NOTE (8GB M1): `go test -race` + `tsc` + vitest are the memory-heavy ones; if
# this ever swaps, run fewer concurrently here.
JOBDIR=$(mktemp -d)
trap 'rm -rf "$JOBDIR"' EXIT
JOBS=""

launch() { # launch <name> <command-string>
  _name="$1"
  _cmd="$2"
  (
    sh -c "$_cmd" >"$JOBDIR/$_name.log" 2>&1
    echo $? >"$JOBDIR/$_name.done"
  ) &
  JOBS="$JOBS $_name"
}

CHANGED=$(git diff --cached --name-only)

if printf '%s\n' "$CHANGED" | grep -q '^backend/'; then
  if command -v golangci-lint >/dev/null 2>&1; then
    launch "go-lint" "cd backend && golangci-lint run --config ../.github/.golangci.yml --new-from-rev=HEAD --timeout 2m"
  else
    info "golangci-lint not found — skipping (brew install golangci-lint)"
  fi
  launch "go-test" "cd backend && go test -race -short -count=1 ./..."
else
  info "No backend changes — skipping Go lint and tests"
fi

if printf '%s\n' "$CHANGED" | grep -q '^ui/'; then
  launch "eslint" "cd ui/console && npm run lint --silent"
  launch "tsc" "cd ui/console && ./node_modules/.bin/tsc --noEmit"
  # Contract drift guard: strict-parses recorded real payloads against the
  # frontend schemas (the *Contract.test.ts files). Fails if backend
  # serialization drifts from the schema — caught here, never in production.
  launch "contract" "cd ui/console && ./node_modules/.bin/vitest run Contract --silent --passWithNoTests"
else
  info "No frontend changes — skipping ESLint, tsc, contract tests"
fi

# Wait for every background check, then report in launch order.
wait
FAILED_JOBS=""
for name in $JOBS; do
  if [ "$(cat "$JOBDIR/$name.done" 2>/dev/null)" = "0" ]; then
    pass "$name"
  else
    fail "$name"
    FAILED=1
    FAILED_JOBS="$FAILED_JOBS $name"
  fi
done

# Print the output of failed checks only (keeps the happy path quiet).
for name in $FAILED_JOBS; do
  printf "\n${RED}----- %s output -----${NC}\n" "$name"
  cat "$JOBDIR/$name.log"
done

# ── Result ────────────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 1 ]; then
  printf "${RED}Pre-commit checks failed. Fix the errors above and recommit.${NC}\n"
  exit 1
fi

printf "${GREEN}All checks passed.${NC}\n"
