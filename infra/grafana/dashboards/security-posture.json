{
  "title": "Security Posture",
  "uid": "jobradar-security-posture",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["jobradar", "security", "crowdsec"],
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "loki_ds",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" }
      },
      {
        "name": "prom_ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active CrowdSec bans",
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cs_active_decisions)"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Top triggered scenarios (24h)",
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (increase(cs_bucket_overflowed_total[24h])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate-limit 429s per minute (Caddy)",
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service=\"caddy\"} | json | status=\"429\" [1m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent CrowdSec decisions",
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"crowdsec\"} |~ \"decision|ban|allow\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
