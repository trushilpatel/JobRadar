      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "stacking": { "mode": "none", "group": "A" }
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },

