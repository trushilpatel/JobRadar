{
  "title": "JobRadar — Crawler Node",
  "uid": "jobradar-crawler-node",
  "tags": ["jobradar", "crawler-node"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "title": "Pipeline Overview",
      "type": "link",
      "url": "/d/jobradar-pipeline-overview",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scans Rate",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crawler_scans_total{job=\"jobradar_crawler_node\"}[5m]))",
          "legendFormat": "scans/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs Fetched Rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(crawler_jobs_fetched_total{job=\"jobradar_crawler_node\"}[5m])",
          "legendFormat": "jobs/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 Scan Duration",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(crawler_scan_duration_seconds_bucket{job=\"jobradar_crawler_node\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scans Reassigned (stuck)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(crawler_scan_aborted_reassigned_total{job=\"jobradar_crawler_node\"}[5m])",
          "legendFormat": "reassigned/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scans by Status",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crawler_scans_total{job=\"jobradar_crawler_node\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan Duration Percentiles",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(crawler_scan_duration_seconds_bucket{job=\"jobradar_crawler_node\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(crawler_scan_duration_seconds_bucket{job=\"jobradar_crawler_node\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(crawler_scan_duration_seconds_bucket{job=\"jobradar_crawler_node\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Publish Failures by Adapter",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crawler_publish_failures_total{job=\"jobradar_crawler_node\"}[5m])) by (adapter)",
          "legendFormat": "{{adapter}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Non-USA Jobs Dropped by Adapter",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(crawler_jobs_non_usa_dropped_total{job=\"jobradar_crawler_node\"}[5m])) by (adapter)",
          "legendFormat": "{{adapter}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Scans Aborted / Reassigned (stuck heartbeat)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(crawler_scan_aborted_reassigned_total{job=\"jobradar_crawler_node\"}[5m])",
          "legendFormat": "reassigned/s"
        }
      ]
    }
  ]
}
