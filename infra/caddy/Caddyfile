{
	email {$ACME_EMAIL}
	# Optional ACME CA override — set to LE staging URL in dev to avoid rate limits.
	# Example: ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Metrics endpoint — scrape from inside the compose network only.
	servers {
		metrics
	}

	# CrowdSec bouncer — global app config.
	crowdsec {
		api_url {$CROWDSEC_LAPI_URL:http://crowdsec:8080}
		api_key {$CROWDSEC_LAPI_KEY}
		ticker_interval 10s
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://{$SUPABASE_PROJECT_HOST} https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
		-Server
	}
}

(crowdsec) {
	crowdsec
}

app.{$DOMAIN} {
	import security_headers
	import crowdsec

	log {
		output file /var/log/caddy/app.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	rate_limit {
		zone per_ip_api {
			key {remote_host}
			events {$RATE_LIMIT_API_PER_MIN:30}
			window 1m
		}
		zone per_ip_callback {
			key {remote_host}
			events {$RATE_LIMIT_CALLBACK_PER_MIN:5}
			window 1m
		}
	}

	@api path /api/*
	handle @api {
		rate_limit per_ip_api
		uri strip_prefix /api
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	@callback path /auth/callback
	handle @callback {
		rate_limit per_ip_callback
		reverse_proxy console:8080
	}

	handle {
		reverse_proxy console:8080
	}
}

grafana.{$DOMAIN} {
	import security_headers
	import crowdsec

	log {
		output file /var/log/caddy/grafana.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	reverse_proxy grafana:3000 {
		header_up X-Real-IP {remote_host}
	}
}
