# AutoCodeEngine config — gitignored, never committed.
# Override any variable per-run: make run FEATURE=foo MAX_AGENT_CALLS=20
# See .factory.env.example for full documentation of all options.

# ── Models ────────────────────────────────────────────────────────────────────
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6
MODEL_OPUS=claude-opus-4-8

# ── Loop limits ───────────────────────────────────────────────────────────────
MAX_LOOP_BACKS=3
MAX_AGENT_CALLS=10

# ── Per-role turn ceilings (sized for this PRD: migration + Go chain + frontend) ─
# A turn ≈ one read, write/edit, or test-run. Engineer/QA raised so they don't
# truncate mid-implementation on a 13-AC backend+frontend feature.
TURNS_ARCHITECT=18
TURNS_ENGINEER=45
TURNS_QA=35
TURNS_UX=12
TURNS_PUSH_TO_PR=10

# ── Local dev ─────────────────────────────────────────────────────────────────
# Console Vite dev server (used by k6 performance tests)
BASE_URL=http://localhost:3000

# Runs Go backend tests. Auto-detect would also pick up go test ./... but
# make test ensures it runs from the right directory (cd backend first).
TEST_CMD="make test"

# ── Gate control ──────────────────────────────────────────────────────────────
# Run all gates for production features.
# Quick iterations: SKIP_GATES=performance,red_team saves ~6-8 agent calls.
SKIP_GATES=performance,red_team,prd_linter

# ── Engine paths (relative — avoids double-root when Make exports absolute paths) ─
TEMPLATES_DIR=AutoCodeEngine/templates
AGENTS_DIR=AutoCodeEngine/claude-agents

# ── Performance budgets ───────────────────────────────────────────────────────
PERF_P95_MS=300
PERF_P99_MS=1000
PERF_ERROR_RATE=0.01
PERF_BUNDLE_KB=20
