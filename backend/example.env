# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobradar
DB_SSLMODE=disable

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_USER=kafka
KAFKA_PASSWORD=kafkasecret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_DB=0

# ─── LLM (shared) ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

TARGET_ROLES=Backend Engineer,Platform Engineer,Infrastructure Engineer,Software Engineer,Full Stack Engineer,Software Developer
YEARS_EXP=4

# ─── LLM multi-slot routing ───────────────────────────────────────────────────
# Preferred: point at a YAML file (see config/llm-slots.example.yaml).
# API keys in the YAML use ${VAR} syntax and are expanded from this file at load time.
LLM_SLOTS_CONFIG=./config/llm-slots.yaml

# Fallback: JSON env vars (used when LLM_SLOTS_CONFIG is unset or file missing)
# FILTER_LLM_SLOTS='[{"key_id":"k1","api_key":"AIza...","model":"gemini-2.5-flash-lite","rpm":15,"rpd":1500,"tpm_in":1000000}]'
# ENRICHER_LLM_SLOTS='[{"key_id":"k1","api_key":"AIza...","model":"gemini-2.5-pro","rpm":5,"rpd":500,"tpm_in":250000}]'

# ─── LLM cooldown backoff ─────────────────────────────────────────────────────
# On provider 429: min(BASE * 2^(n-1), MAX) * (1 ± JITTER); success resets n.
LLM_COOLDOWN_BASE_SECONDS=60
LLM_COOLDOWN_MAX_SECONDS=3600
LLM_COOLDOWN_JITTER=0.2

# ─── Filter worker ────────────────────────────────────────────────────────────
# FILTER_BATCH_SIZE    — jobs sent to each individual LLM ScoreBatch call
# FILTER_LLM_PARALLELISM — concurrent LLM calls per flush
# Total jobs accumulated before a flush = FILTER_BATCH_SIZE × FILTER_LLM_PARALLELISM
FILTER_BATCH_SIZE=50
FILTER_FLUSH_TIMEOUT_SECONDS=10
FILTER_LLM_PARALLELISM=5

# ─── Enricher worker ──────────────────────────────────────────────────────────
# Two-stage pipeline:
#   Stage 1 — parallel HTTP fetches (FETCH_CONCURRENCY), per-adapter rate-limited
#   Stage 2 — LLM EnrichBatch with LLM_BATCH_SIZE jobs per call
ENRICHER_FETCH_CONCURRENCY=15
ENRICHER_LLM_BATCH_SIZE=5
ENRICHER_FLUSH_TIMEOUT_SECONDS=120
ENRICHER_DEFAULT_RPS=2
ENRICHER_DEFAULT_BURST=3
ENRICHER_JITTER_MS=200
DISCARD_JOB_WITH_EXP_GT=0

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=480
SCHEDULER_STUCK_TIMEOUT_MINUTES=30
SCHEDULER_CHECK_INTERVAL_SECONDS=60

# ─── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_POLL_INTERVAL_SECONDS=60
CRAWLER_STUCK_TIMEOUT_SECONDS=120
CRAWLER_HEARTBEAT_INTERVAL_SECONDS=30
SCAN_COMPANY_DELAY_SECONDS=60

# ─── Google scraper ───────────────────────────────────────────────────────────
GOOGLE_SCRAPER_MIN_DELAY=15000        # ms between page loads (dev: 15s; prod default: 120000)
GOOGLE_SCRAPER_MAX_DELAY=20000        # ms between page loads (dev: 20s; prod default: 240000)
GOOGLE_SCRAPER_TIMEOUT_MS=60000       # total scrape timeout per company (dev: 60s; prod default: 14400000)
GOOGLE_SCRAPER_MAX_PAGES=2            # 0 = unlimited
GOOGLE_SCRAPER_ENRICH_MIN=60000       # ms delay when loading individual job pages
GOOGLE_SCRAPER_ENRICH_MAX=120000      # ms delay when loading individual job pages

# ─── Observability ────────────────────────────────────────────────────────────
METRICS_ADDR=:9090
JAEGER_ENDPOINT=http://localhost:4318

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
