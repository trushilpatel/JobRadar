DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobradar
DB_SSLMODE=disable

KAFKA_BROKERS=localhost:9092
KAFKA_USER=kafka
KAFKA_PASSWORD=kafkasecret

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemma-4-31b-it #gemini-3.1-flash-lite-preview

TARGET_ROLES=Backend Engineer,Platform Engineer,Infrastructure Engineer,Software Engineer,Full Stack Engineer,Software Developer
YEARS_EXP=4

SCORER_BATCH_SIZE=50           # default, safe for lite models
SCORER_FLUSH_TIMEOUT_SECONDS=10  # flush partial batch after 10s idle

# Minimum time before the same company is re-scanned (scheduler cooldown).
# Examples: 60 (hourly), 720 (every 12h), 1440 (daily)
SCAN_INTERVAL_MINUTES=480 # 12 hours

# Pacing pause between back-to-back company scans in the crawler (host throttle).
# Applied AFTER queue.Complete, so the queue row isn't held during the sleep.
SCAN_COMPANY_DELAY_SECONDS=60 # 1 minute

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Observability
# Metrics/health server address for background workers (api uses :8080).
# Each worker service overrides this in docker-compose.
METRICS_ADDR=:9090


GOOGLE_SCRAPER_MIN_DELAY_MS=15000 #ms
GOOGLE_SCRAPER_MAX_DELAY_MS=20000 #ms
GOOGLE_SCRAPER_TIMEOUT_MS=60000 #ms
GOOGLE_SCRAPER_MAX_PAGES=2 # No LImit