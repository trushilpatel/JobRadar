# Binaries
bin/
*.exe
*.out

# Go build output — binaries dropped in backend/ by `go build ./apps/...`
backend/api
backend/scheduler
backend/crawler
backend/filter
backend/analyzer
backend/enricher
backend/migrate

# Go build cache
/vendor/

# Environment variables — never commit real .env files anywhere in the repo
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Test coverage
*.coverprofile
coverage.out

*node_modules*

# Google scraper local test output
backend/internal/ats_fetcher/google/scraper/jobs.json
backend/internal/ats_fetcher/google/scraper/logs.json

# Git Worktrees (isolated agent workspaces)
.worktrees/

# Superpowers brainstorming session artifacts (local only)
.superpowers/

# Runtime secrets (Docker secrets files — never commit real values)
secrets/

# Kubernetes secrets — never commit real values
k8s/**/secret.yaml

# Local Helm overrides (secrets — never commit)
values.local.yaml

# k8s image build digest cache (local only — used to skip unchanged builds)
.k8s-build-cache/

# Helm chart dependencies (downloaded, not committed)
k8s/helm/observability/charts/*.tgz
k8s/helm/observability/charts/alloy/
