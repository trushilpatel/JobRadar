apiVersion: v1
kind: Secret
metadata:
  name: jobradar-filter-secret
  namespace: jobradar-local
  labels:
    app: jobradar
    component: filter
    environment: local
type: Opaque
stringData:
  DB_HOST: "your-supabase-host.supabase.co"
  DB_USER: "postgres"
  DB_PASSWORD: "your-db-password"
  DB_NAME: "postgres"
  KAFKA_USER: "your-kafka-user"
  KAFKA_PASSWORD: "your-kafka-password"
  # JSON array of LLM slot configs — see config.LLMSlotConfig for schema
  FILTER_LLM_SLOTS: '[{"key_id":"slot0","api_key":"your-gemini-key","model":"gemini-2.0-flash","rpm":15,"rpd":1500,"tpm_in":1000000}]'
  TARGET_ROLES: "Software Engineer,Backend Engineer"
  YEARS_EXP: "0"
