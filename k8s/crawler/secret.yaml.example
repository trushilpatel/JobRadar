apiVersion: v1
kind: Secret
metadata:
  name: jobradar-crawler-secret
  namespace: jobradar-local
  labels:
    app: jobradar
    component: crawler
    environment: local
type: Opaque
stringData:
  DB_HOST: "your-supabase-host.supabase.co"
  DB_USER: "postgres"
  DB_PASSWORD: "your-db-password"
  DB_NAME: "postgres"
  KAFKA_USER: "your-kafka-user"
  KAFKA_PASSWORD: "your-kafka-password"
