apiVersion: v1
kind: Secret
metadata:
  name: jobradar-analyzer-secret
  namespace: jobradar-local
  labels:
    app: jobradar
    component: analyzer
    environment: local
type: Opaque
stringData:
  DB_HOST: "your-supabase-host.supabase.co"
  DB_USER: "postgres"
  DB_PASSWORD: "your-db-password"
  DB_NAME: "postgres"
  TARGET_ROLES: "Software Engineer,Backend Engineer"
  YEARS_EXP: "0"
  # JSON array of LLM slot configs — see config.LLMSlotConfig for schema
  ENRICHER_LLM_SLOTS: '[{"key_id":"slot0","api_key":"your-gemini-key","model":"gemma-4-31b-it","rpm":15,"rpd":1500,"tpm_in":1000000}]'
