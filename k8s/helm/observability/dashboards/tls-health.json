{
  "title": "TLS Health",
  "uid": "jobradar-tls-health",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["jobradar", "tls", "caddy"],
  "timezone": "browser",
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "prom_ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cert expiry (days remaining)",
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (identifier) ((caddy_certificates_expiry_seconds - time()) / 86400)",
          "legendFormat": "{{identifier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cert expiry trend",
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "(caddy_certificates_expiry_seconds - time()) / 86400",
          "legendFormat": "{{identifier}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "d" } }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Managed certificates",
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "caddy_certificates_managed",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Cert renewals",
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "enable": true,
        "expr": "changes(caddy_certificates_expiry_seconds[1h]) > 0"
      }
    ]
  },
  "__alerts_note__": "Alert rule at T-14d is defined in infra/grafana/alerts/ (provisioned separately). Threshold must match the red band in panel 1.",
  "__alert_rule_suggestion__": {
    "name": "TLS cert expires in <14 days",
    "expr": "min((caddy_certificates_expiry_seconds - time()) / 86400) < 14",
    "for": "10m",
    "labels": { "severity": "critical" },
    "annotations": { "summary": "JobRadar TLS cert expiring soon" }
  }
}
